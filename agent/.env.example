# Kopie als agent/.env anlegen und Werte dort eintragen. agent/.env ist gitignored.
# ACHTUNG: Diese Datei (.env.example) wird eingecheckt -> hier NIEMALS echte Schluessel eintragen.

# --- Azure AI Speech (STT + TTS) --------------------------------------------
# Azure-Portal -> Speech-Ressource (Region Germany West Central)
#   -> "Keys and Endpoint" -> KEY 1 + Region
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=germanywestcentral
# Deutsche Stimmen z.B.: de-DE-ConradNeural (m), de-DE-KatjaNeural (w),
# de-DE-FlorianMultilingualNeural (m), de-DE-SeraphinaMultilingualNeural (w)
AZURE_TTS_VOICE=de-DE-ConradNeural

# --- Azure OpenAI (LLM) ---------------------------------------------------
# Azure-Portal -> Azure OpenAI (Region Germany West Central oder Sweden Central)
# Deployment vorher in Azure AI Foundry anlegen. Modell: gpt-4.1-mini
#   (Nachfolger von gpt-4o-mini; fuer Latenztests in Woche 3 auch gpt-4.1-nano gegentesten)
# Endpoint MUSS auf /openai/v1 enden (Pipecats AzureLLMService schaltet daran auf die
# neue Azure-v1-API; die alte datierte api-version ist deprecated und wird ignoriert).
AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
