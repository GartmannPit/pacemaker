# Kopie als agent/.env anlegen und Werte dort eintragen. agent/.env ist gitignored.
# ACHTUNG: Diese Datei (.env.example) wird eingecheckt -> hier NIEMALS echte Schluessel eintragen.

# --- Stack live: OpenAI GPT-Live (Gruenderentscheidung 2026-10-15) ------------
# OpenAI-Projekt-Key (platform.openai.com). Gilt auch fuer die US-Baseline weiter unten.
OPENAI_API_KEY=
# PFLICHT, kein Default: eu = EU-Residenz (eu.api.openai.com, EWR + Schweiz; erst nach
# Freigabe des Projekts), referenz = api.openai.com (nur markierte Referenzlaeufe mit
# synthetischen Clips ohne reale Personendaten, CLAUDE.md).
OPENAI_LIVE_REGION=
# Stimme (z. B. vesper, meridian, stone); leer = Vorgabe der API
OPENAI_LIVE_VOICE=
# Hintergrundmodell fuer delegierte Arbeit (Werkzeuge wie `auflegen`)
OPENAI_LIVE_BACKEND_MODEL=gpt-4.1-mini

# --- Azure AI Speech (STT + TTS) --------------------------------------------
# Azure-Portal -> Speech-Ressource (Region Germany West Central)
#   -> "Keys and Endpoint" -> KEY 1 + Region
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=germanywestcentral
# Deutsche Stimmen z.B.: de-DE-ConradNeural (m), de-DE-KatjaNeural (w),
# de-DE-FlorianMultilingualNeural (m), de-DE-SeraphinaMultilingualNeural (w)
AZURE_TTS_VOICE=de-DE-ConradNeural

# --- Azure OpenAI (LLM) ---------------------------------------------------
# Foundry-Ressource (ai.azure.com), EU-Region; keine eigenstaendige "Azure OpenAI"-Ressource
# noetig (docs/phase-0-setup.md §2.2). Deployment dort anlegen. Empfohlen (Phase-0-Ergebnis): gpt-4.1-mini,
#   Typ "Data Zone Standard", Inhaltsfilter im Streaming-Modus "Asynchronous Filter".
#   gpt-4.1-nano ist ~150 ms schneller, traegt die Persona aber nicht (Rollentest T3).
# Endpoint MUSS auf /openai/v1 enden (Pipecats AzureLLMService schaltet daran auf die
# neue Azure-v1-API; die alte datierte api-version ist deprecated und wird ignoriert).
AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Weitere Text-Modelle derselben Ressource (z.B. gpt-4.1-nano) brauchen keine eigenen
# Variablen: pro Lauf AZURE_OPENAI_DEPLOYMENT ueberschreiben, z.B.
#   AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano uv run python -m pacemaker_agent.tests.synthetic_caller
# Deployment-Typ in Azure AI Foundry: "Standard" (EU-Region) oder "Data Zone Standard" (EU).
# NICHT "Global Standard" -- verarbeitet ggf. ausserhalb der EU (siehe CLAUDE.md).

# --- Azure OpenAI Realtime (Stack s2s) ------------------------------------
# Endpoint auf der v1-API: wss://<name>.openai.azure.com/openai/v1/realtime
# (ein angehaengtes ?model=... wird ignoriert, das Deployment kommt aus der Variable unten).
AZURE_OPENAI_REALTIME_ENDPOINT=wss://<name>.openai.azure.com/openai/v1/realtime
# Leer lassen, wenn das Deployment in derselben Ressource liegt (dann gilt AZURE_OPENAI_API_KEY).
AZURE_OPENAI_REALTIME_API_KEY=
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1
# Realtime-Stimme (Persona ist maennlich), z.B. cedar, marin, ash
AZURE_OPENAI_REALTIME_VOICE=cedar
# Reasoning-Stufe (nur reasoning-faehige Modelle): minimal, low, medium, high. Leer = Server-Default.
AZURE_OPENAI_REALTIME_REASONING_EFFORT=

# --- Stack A: US-Baseline (NUR Referenzmessung, nie Produktpfad) ---------
# Anleitung: docs/phase-0-setup-stack-a.md
DEEPGRAM_API_KEY=
# OPENAI_API_KEY: siehe Stack live oben
# Optional, Default gpt-4.1-mini (gleiches Modell wie azure-eu, damit nur die Provider verglichen werden)
OPENAI_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Hybrid-Server (Phase 1, Schritt 1; docs/phase-1-schritt-1-server.md) ---
# Nutzt zusaetzlich OPENAI_API_KEY, OPENAI_LIVE_REGION, OPENAI_LIVE_BACKEND_MODEL (oben).
# Pfade ausserhalb des Repos waehlen, z. B. ~/.pacemaker/...
PACEMAKER_USERS_FILE=
PACEMAKER_STATE_DIR=
# Exakte oeffentliche Origin (Schema, Host, Port). Lokal: http://localhost:8080 mit DEV_LOOPBACK=1
PACEMAKER_PUBLIC_ORIGIN=
PACEMAKER_DEV_LOOPBACK=0
PACEMAKER_HOST=127.0.0.1
PACEMAKER_PORT=8080
PACEMAKER_MAX_PARALLEL=20
PACEMAKER_MAX_DURATION_S=600
PACEMAKER_BUDGET_USD=25
# Gebautes Frontend (web/: pnpm build), absoluter Pfad zu web/dist; Pflicht (Schritt 2)
PACEMAKER_WEB_DIST=
# Stimme der Persona, leer = API-Vorgabe; erlaubt: vesper meridian stone ripple gleam willow quartz delta
PACEMAKER_VOICE=
